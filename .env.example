# Site
# The public origin, with no trailing slash (e.g. https://snap-expenses.com).
#
# Used for the Stripe return URLs, the sitemap and robots.txt, and metadataBase
# for Open Graph. It is configuration rather than something read off the request
# because both `Origin` (caller-controlled) and the bound host (wrong behind a
# proxy) are untrustworthy — see src/lib/site-url.ts.
#
# Optional on Vercel, which sets VERCEL_PROJECT_PRODUCTION_URL as a fallback,
# but set it explicitly in production so the value does not depend on which
# deployment is serving.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Test login (magic-link bypass) — see docs/test-login.md
# Optional. Leave all three unset to disable it entirely; that is the correct
# state for production. Setting only some of them also leaves it disabled.
# Generate the secret with: openssl rand -base64 24
TEST_LOGIN_EMAIL=
TEST_LOGIN_SECRET=
NEXT_PUBLIC_TEST_LOGIN_EMAIL=

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Pro is sold on both cycles. Both ids must also appear in priceToPlan() in
# src/app/api/stripe/webhook/route.ts — an unrecognised price there silently
# downgrades a paying customer to free.
STRIPE_PRO_YEARLY_PRICE_ID=price_your_pro_yearly_price_id
STRIPE_PRO_MONTHLY_PRICE_ID=price_your_pro_monthly_price_id

# Team is hidden from /pricing (see PLANS in src/lib/plans.ts). Leaving this
# unset is the second gate that makes /checkout?plan=team bounce to /pricing.
# Set it only when Team is listed again.
STRIPE_TEAM_MONTHLY_PRICE_ID=

# Analytics
# Comma-separated list of emails allowed to open /admin/analytics. Everyone
# else — including signed-in users — gets a 404.
#
# FAILS CLOSED: unset means nobody, in every environment. That is deliberate;
# see src/lib/admin.ts. If the dashboard 404s for you, this is why.
#
# Event collection itself does not depend on this. Events are recorded from the
# moment db/migrations/2026-08-13-analytics-events.sql has been run; this
# variable only governs who may read them back.
ANALYTICS_ADMIN_EMAILS=
